# Runtime mode
NODE_ENV=development
PORT=3000

# Required production session and Owner settings
JWT_SECRET=replace-with-at-least-32-random-characters
OWNER_OPEN_ID=replace-with-existing-owner-open-id

# Existing Adam POS TiDB Cloud connection; keep credentials only in a secret store
EXTERNAL_DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:4000/DATABASE

# Existing Manus Forge server-side integration
BUILT_IN_FORGE_API_URL=https://replace-with-forge-api-host
BUILT_IN_FORGE_API_KEY=replace-with-forge-api-key

# Server-only Gemini API key for invoice image/PDF analysis
GEMINI_API_KEY=replace-with-gemini-api-key

# Optional frontend Forge Maps integration
VITE_FRONTEND_FORGE_API_URL=https://replace-with-frontend-forge-api-host
VITE_FRONTEND_FORGE_API_KEY=replace-with-frontend-forge-api-key

# Optional analytics referenced by client/index.html
VITE_ANALYTICS_ENDPOINT=https://replace-with-analytics-host
VITE_ANALYTICS_WEBSITE_ID=replace-with-analytics-website-id
